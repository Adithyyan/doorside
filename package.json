{
  "name": "dropshipping-platform",
  "version": "1.0.0",
  "description": "India-first dropshipping e-commerce platform",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspace=web & npm run dev --workspace=server",
    "web": "npm run dev --workspace=web",
    "server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=web",
    "lint": "npm run lint --workspace=server",
    "test": "npm run test --workspace=server",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js"
  },
  "workspaces": [
    "web",
    "server"
  ],
  "dependencies": {
    "dayjs": "^1.11.23"
  }
}
